# ==============================================================================
# Computer-Use Automation System — configuration template
# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
#
# There are exactly two LLM roles, and BOTH are provider-agnostic: point each at
# any OpenAI-compatible endpoint by setting its *_BASE_URL / *_MODEL / *_API_KEY.
# Nothing is hard-wired to DeepSeek or Kimi — they are simply the defaults below.
#
#   DECISION LLM  — drives discovery (observe → decide → act), structured JSON.
#   VISION  LLM   — screenshot-understanding fallback for image-only surfaces.
#
# You only need API keys to RECORD new tasks. Viewing and replaying the
# pre-recorded tasks needs no LLM at all (replay is deterministic).
# ==============================================================================

# ------------------------------------------------------------------------------
# DECISION LLM  (observe → decide → act, structured JSON output)
# ------------------------------------------------------------------------------
# REQUIRED to record new tasks.
DECISION_LLM_API_KEY=

# OpenAI-compatible base URL. Examples:
#   DeepSeek   → https://api.deepseek.com
#   OpenAI     → https://api.openai.com/v1
#   OpenRouter → https://openrouter.ai/api/v1
#   Local vLLM → http://localhost:8000/v1
DECISION_LLM_BASE_URL=https://api.deepseek.com

# Model name. Examples: deepseek-v4-pro, gpt-4o, openrouter/<model>, ...
DECISION_LLM_MODEL=deepseek-v4-pro

# Sampling temperature (optional; 0.2 is a sensible default for structured output).
DECISION_LLM_TEMPERATURE=0.2

# Whether to send response_format={"type":"json_object"} (optional).
# Most OpenAI-compatible APIs support it; set 0 for providers that don't.
DECISION_LLM_JSON_MODE=1

# Max output tokens (optional). Keep it generous: reasoning models spend most of
# their budget on the reasoning monologue and still need room for the answer.
DECISION_LLM_MAX_TOKENS=8192

# ------------------------------------------------------------------------------
# VISION LLM  (screenshot understanding fallback)
# ------------------------------------------------------------------------------
# REQUIRED to record new tasks on image-only / non-semantic surfaces.
VISION_LLM_API_KEY=

# OpenAI-compatible base URL. Examples:
#   Kimi/Moonshot → https://api.moonshot.cn/v1   (the .ai endpoint returns Invalid Auth)
#   OpenAI        → https://api.openai.com/v1
#   OpenRouter    → https://openrouter.ai/api/v1
VISION_LLM_BASE_URL=https://api.moonshot.cn/v1

# Model name. Examples: kimi-k3, gpt-4o, openrouter/<model>, ...
VISION_LLM_MODEL=kimi-k3

# Sampling temperature (optional). Note: some reasoning models (e.g. kimi-k3)
# only accept temperature=1; other models accept lower values.
VISION_LLM_TEMPERATURE=1

# Max output tokens (optional). Keep it generous — reasoning models spend most
# of their budget on the monologue and still need room for the final answer.
VISION_LLM_MAX_TOKENS=8192

# ------------------------------------------------------------------------------
# Target surface
# ------------------------------------------------------------------------------
# The local "legacy bank" mock the pre-recorded tasks run against.
MOCK_URL=http://localhost:9000/
